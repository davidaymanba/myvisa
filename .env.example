# ─── myvisa local environment ───────────────────────────────────────────────
# Copy to `.env` (repo root). Read by docker compose, packages/db (Prisma) and apps/api.
# apps/web has its own apps/web/.env.example.

NODE_ENV=development

# Infra — matches docker-compose.yml (host ports are offset from the defaults)
DATABASE_URL=postgresql://myvisa:myvisa@localhost:5442/myvisa
TEST_DATABASE_URL=postgresql://myvisa:myvisa@localhost:5442/myvisa_test
REDIS_URL=redis://localhost:6390
SMTP_URL=smtp://localhost:1035

# API
API_PORT=4100
# Comma-separated origins allowed to call the API from a browser (the web app proxies /api in dev, so this is a fallback).
CORS_ORIGINS=http://localhost:3100
# Public URL of the web app (used in links and CSRF origin checks).
WEB_URL=http://localhost:3100
# Leave empty on localhost. In production set the parent domain (e.g. .myvisa.sa) so web + api share cookies.
COOKIE_DOMAIN=
LOG_LEVEL=debug

# Auth — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Pepper for OTP and refresh-token hashes (HMAC-SHA256).
HASH_PEPPER=dev-pepper-change-me-dev-pepper-change-me
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Fixed code accepted in development only (never in production). Leave empty to always send a random code.
OTP_DEV_CODE=000000

# SMS — console | unifonic | taqnyat
SMS_PROVIDER=console
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=myvisa
TAQNYAT_BEARER_TOKEN=
TAQNYAT_SENDER=myvisa

# Revalidates the web app's cached catalog after admin edits (must match apps/web REVALIDATE_SECRET).
WEB_REVALIDATE_URL=http://localhost:3100/api/revalidate
REVALIDATE_SECRET=dev-revalidate-secret

# Public URL the payment gateway calls back (webhooks) and the API's own base URL.
API_PUBLIC_URL=http://localhost:4100

# Object storage (S3 API). Local: SeaweedFS from docker-compose. Production: AWS S3 or Cloudflare R2.
S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_BUCKET=myvisa-documents
S3_ACCESS_KEY=myvisa
S3_SECRET_KEY=myvisa-secret-key
S3_FORCE_PATH_STYLE=true
# none | AES256 (SSE-S3). R2 always encrypts at rest; on AWS set AES256 or use bucket default encryption.
S3_SSE=none
# Create the bucket on startup (development only).
S3_AUTO_CREATE_BUCKET=true

# Virus scanning (ClamAV clamd). Leave empty in development to skip scanning (files are marked clean).
CLAMAV_HOST=
CLAMAV_PORT=3310

# PII encryption (passport / ID numbers): 32 random bytes, base64. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=__generate__
# Key for the blind index (exact-match search over encrypted values). Different from the above.
BLIND_INDEX_KEY=dev-blind-index-key-change-me

# Background jobs (BullMQ on Redis): document scans and notifications. Set false to run an API-only node.
QUEUE_WORKERS=true

# Payments — mock | moyasar | tap. "mock" is a local fake gateway for development only.
PAYMENT_PROVIDER=mock
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TAP_SECRET_KEY=

# Email — console | smtp | resend
EMAIL_PROVIDER=smtp
EMAIL_FROM="myvisa <no-reply@myvisa.sa>"
RESEND_API_KEY=

# WhatsApp — console | meta (WhatsApp Business Cloud API, approved templates)
WHATSAPP_PROVIDER=console
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ZATCA e-invoicing (EGS unit). From onboarding: secp256k1 private key (PEM) and the production CSID certificate.
# Empty in development: invoices are signed with a throwaway key. Empty in production: hashed and chained, unsigned.
ZATCA_EGS_PRIVATE_KEY=
ZATCA_EGS_CERTIFICATE=

# Observability — Sentry is a no-op until a DSN is set.
SENTRY_DSN=

# Seed — phone of the first SUPER_ADMIN (signs in with OTP).
SEED_ADMIN_PHONE=+966500000001

# Swagger UI at /docs: on by default except in production. Set true to expose it (e.g. on a staging API).
# API_DOCS=false
