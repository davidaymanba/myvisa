{
  "name": "myvisa",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:validate": "pnpm --filter @myvisa/db validate",
    "db:generate": "pnpm --filter @myvisa/db generate",
    "visual-tour": "node scripts/visual-tour.mjs",
    "infra:up": "docker compose up -d postgres redis mailpit s3",
    "infra:down": "docker compose down",
    "db:migrate": "pnpm --filter @myvisa/db migrate",
    "db:deploy": "pnpm --filter @myvisa/db migrate:deploy",
    "db:seed": "pnpm --filter @myvisa/db seed",
    "db:seed-demo": "pnpm --filter @myvisa/api build && node apps/api/dist/scripts/seed-demo.js",
    "db:reset": "pnpm --filter @myvisa/db reset",
    "test:e2e": "pnpm --filter @myvisa/api test:e2e",
    "admin-tour": "node scripts/admin-tour.mjs",
    "apply-tour": "node scripts/apply-tour.mjs",
    "account-tour": "node scripts/account-tour.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "playwright-core": "^1.64.1",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
