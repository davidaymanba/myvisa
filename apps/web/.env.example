# Copy to apps/web/.env.local

# Where the Next.js server reaches the API (server-side fetches and the /api/v1 proxy).
API_URL=http://localhost:4100

# Public site URL (canonical links, sitemap).
# NEXT_PUBLIC_SITE_URL=http://localhost:3100  (defaults to https://myvisa.sa)

# Must equal the API's JWT_ACCESS_SECRET: the middleware verifies the access cookie before serving /admin.
JWT_ACCESS_SECRET=dev-access-secret-change-me-dev-access-secret-change-me

# Shared with the API (REVALIDATE_SECRET): lets admin edits refresh cached pages instantly.
REVALIDATE_SECRET=dev-revalidate-secret
