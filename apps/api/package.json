{
  "name": "@myvisa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --enable-source-maps dist/main.js\"",
    "build": "tsup",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
